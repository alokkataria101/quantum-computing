# ── Storage paths ─────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
DATABASE_PATH=./storage/books.db

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600      # 100 MB

# ── OCR ───────────────────────────────────────────────────────────────────────
# Set OCR_ENABLED=false if tesseract is not installed (indexing still works via
# PyMuPDF text layer; scanned/image-only pages will just have empty text).
TESSERACT_CMD=tesseract         # path to tesseract binary if not on PATH
OCR_ENABLED=false
OCR_LANGUAGE=eng

# ── Page rendering ────────────────────────────────────────────────────────────
RENDER_DPI=150

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# Set to a real secret in production; leave empty for localhost-only use.
API_SECRET_KEY=
